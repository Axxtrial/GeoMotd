<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>us.axspace</groupId>
        <artifactId>geomotd-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>geomotd-bungee</artifactId>
    <packaging>jar</packaging>

    <name>GeoMOTD Bungee</name>
    <description>BungeeCord and Waterfall module for GeoMOTD</description>

    <dependencies>
        <dependency>
            <groupId>us.axspace</groupId>
            <artifactId>geomotd-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- BungeeCord API -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
            <version>${bungee.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>GeoMOTD-Bungee-${project.version}</finalName>
                            <relocations>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>us.axspace.geomotd.libs.caffeine</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.maxmind.db</pattern>
                                    <shadedPattern>us.axspace.geomotd.libs.maxmind.db</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>us.axspace.geomotd.libs.snakeyaml</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori</pattern>
                                    <shadedPattern>us.axspace.geomotd.libs.kyori</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
