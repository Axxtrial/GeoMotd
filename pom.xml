<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>us.axspace</groupId>
    <artifactId>geomotd-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>GeoMOTD Parent</name>
    <description>Ultra-fast GeoIP Multi-Language MOTD for Paper, Folia, Velocity, and BungeeCord</description>

    <modules>
        <module>geomotd-core</module>
        <module>geomotd-paper</module>
        <module>geomotd-velocity</module>
        <module>geomotd-bungee</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <caffeine.version>3.1.8</caffeine.version>
        <maxmind.version>3.1.1</maxmind.version>
        <adventure.version>4.17.0</adventure.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <gson.version>2.10.1</gson.version>

        <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
        <velocity.version>3.3.0-SNAPSHOT</velocity.version>
        <bungee.version>1.20-R0.2</bungee.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>sonatype-snapshots</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>
</project>
